PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Option A – individual vars (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accommodation_support
DB_USER=postgres
DB_PASSWORD=your_password

# Option B – connection string (Neon / Render / Supabase — takes priority if set)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_too_a_different_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
